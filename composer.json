{
    "name": "authstudio/laravel-oauth-login",
    "type": "project",
    "description": "Auth Studio - a Laravel OAuth + email/password login system with two-step verification.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/socialite": "^5.26",
        "socialiteproviders/microsoft": "^4.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
